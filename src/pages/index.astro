---
import Layout from '../layouts/Layout.astro';
import ProfileCard from '../components/sidebar/ProfileCard';
import MusicCard from '../components/sidebar/MusicCard';
import LinksCard from '../components/sidebar/LinksCard';
import BlogCard from '../components/sidebar/BlogCard';
import WebringCard from '../components/sidebar/WebringCard';
import StatsCard from '../components/sidebar/StatsCard';
import WebtilesCard from '../components/sidebar/WebtilesCard';
import './index.css'
import DraggableGallery from '../components/ui/DraggableGallery';
import { getCollection } from "astro:content";
import AboutIntro from "../components/ui/AboutIntro.astro";
import AboutHobbies from "../components/ui/AboutHobbies.astro";
import AboutGames from "../components/ui/AboutGames.astro";
import Projects from "../components/projects/Projects";
import GitHubActivity from "../components/ui/GitHubActivity";
const albums = await getCollection("albums");

const iosAlbums = albums.filter(album => album.id.startsWith('rice') && !album.id.startsWith('macrice') && !album.id.startsWith('linuxrice'));
// const linuxAlbums = albums.filter(album => album.id.startsWith('linuxrice'));
// const macosAlbums = albums.filter(album => album.id.startsWith('macrice'));


const blogPosts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2)
  .map((post) => ({
    title: post.data.title,
    date: post.data.date.toLocaleDateString(),
    slug: post.slug,
  }));
---

<Layout title="htrowii's website">
	<div class="page-islands">
		<ProfileCard client:load />
		<AboutIntro />
		<Projects client:load />
		<AboutHobbies />
		<AboutGames />
		<MusicCard client:load />
		<LinksCard />
		<BlogCard blogPosts={blogPosts} />
		<div class="community">
			<WebringCard />
			<StatsCard client:load />
			<!-- <WebtilesCard /> -->
		</div>
		<div class="github-card card">
			<GitHubActivity client:load />
		</div>
		<DraggableGallery albums={iosAlbums} client:load />
	</div>
</Layout>
